# Copy this to .env and adjust if needed. Defaults work out of the box.

# Working dirs
DATA_DIR=./data
VAULT_DIR=./vault

# Frame sampling
FRAME_INTERVAL_SECONDS=7

# STT
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# Ollama (local server, must be running: `ollama serve`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VLM_MODEL=moondream
OLLAMA_LLM_MODEL=qwen2.5:1.5b
